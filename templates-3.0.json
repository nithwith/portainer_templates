      "env": [
			{
				"name": "PROJECT_NAME",
				"label": "Project name",
				"description": "Odoo"
			},
			{
				"name": "PROJECT_URL",
				"label": "Project url",
				"description": "odoo.yourdomain.com"
			},
			{
				"name": "ODOO_VERSION",
				"label": "Odoo version",
				"description": "12.0"
			},
			{
				"name": "HTTP_PORT",
				"label": "Http port",
				"description": "8069"
			},
			{
				"name": "POLL_PORT",
				"label": "Poll port",
				"description": "8072"
			}]
    },
	{
      "id": 22,
      "type": 2,
      "title": "Swarm monitoring",
      "description": "Monitor your cluster performances with Prometheus & Grafana",
